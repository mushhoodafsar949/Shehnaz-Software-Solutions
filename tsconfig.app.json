{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      "node"
    ],
    "paths": {
      "primeng/*": ["./node_modules/primeng/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "node_modules/primeng/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/app/core/core.module.ts",
    "src/app/core/intersection-observer.service.ts",
    "src/app/core/scroll.service.ts",
    "src/app/features/feedback/feedback.module.ts",
    "src/app/shared/directives/lazy-load.directive.ts"
  ]
}