{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      "node"
    ],
    "paths": {
      "primeng/*": ["./node_modules/primeng/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "node_modules/primeng/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}